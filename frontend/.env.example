# ---- Frontend environment (copy to .env and fill in) ----
# Read by Vite — every var MUST be prefixed with VITE_.
# Restart `npm run dev` after changing these.

# Base URL of your Keycloak server.
VITE_KEYCLOAK_URL=http://localhost:8080

# The realm your client lives in, e.g. datapilot
VITE_KEYCLOAK_REALM=datapilot

# The public client ID configured in that realm (PKCE / S256).
VITE_KEYCLOAK_CLIENT_ID=datapilot-frontend

# Base URL of the backend API.
VITE_API_URL=http://localhost:8000
