# ---- Backend environment (copy to .env and fill in) ----

# PostgreSQL connection using the async driver (asyncpg).
# The target database (e.g. "datapilot") must already exist. Point this at
# the Docker Postgres from docker-compose.yml (pgvector/pgvector:pg18, host
# port 5434 by default) -- the Veille réglementaire RAG index needs the
# pgvector extension, which a natively-installed Postgres won't have.
# `docker compose up -d postgres` before starting the backend.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/datapilot

# Keycloak server used to verify access tokens (app/core/auth.py).
KEYCLOAK_URL=http://localhost:8085
KEYCLOAK_REALM=datapilot
KEYCLOAK_ALGORITHMS=RS256
# The SPA client id. If set, the token's `azp` must match it.
KEYCLOAK_CLIENT_ID=datapilot-frontend
# Realm role that grants back-office access (defaults to "super_admin").
# Note: "admin" is now a plain business role with NO back-office access.
KEYCLOAK_SUPER_ADMIN_ROLE=super_admin

# Allowed CORS origin = the frontend dev server URL (app/core/cors.py).
# Also used as the login URL in credentials emails.
FRONTEND_URL=http://localhost:5173

# Keycloak Admin API service account (app/core/keycloak_admin.py).
# Confidential client with realm-management roles view-users/query-users/manage-users.
KEYCLOAK_ADMIN_CLIENT_ID=datapilot-backend
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME

# SMTP used by the backend to email temporary passwords (app/core/mailer.py).
# With Gmail: enable 2FA and use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_NAME=DataPilot

# Generative layer (backend/llm/generation.py): recommendation reformulation
# and results narration -- always the LOCAL model below (Ollama,
# OpenAI-compatible API), no bank data ever leaves the machine. All
# variables are optional and already default to a local Ollama setup;
# only override if yours differs.
# Set LLM_API_KEY="" explicitly to force the non-LLM fallback (e.g. tests).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# qwen32cpu (aliased from qwen2.5:3b) is the default: unlike llama3.2 it
# was trained on meaningful Arabic data, which matters for the "Veille
# réglementaire" local fallback below since BCT circulars can be French OR
# Arabic. `ollama pull qwen2.5:3b` first -- see SETUP.local.md.
LLM_MODEL=qwen32cpu
# How long Ollama keeps the model loaded in memory after a call, so a
# burst of requests (e.g. chunked circular analysis) doesn't pay a cold
# reload each time. Passed through as-is to Ollama's `keep_alive`.
LLM_KEEP_ALIVE=30m
# Optional: pin the number of CPU threads Ollama uses for inference
# (defaults to Ollama's own auto-detection when unset).
# LLM_NUM_THREAD=8

# bge-m3 embeddings (backend/llm/embeddings.py) for the "Veille
# réglementaire" RAG index (questions + recommandations) -- cross-lingual
# FR/AR, always local. `ollama pull bge-m3` first.
EMBEDDING_MODEL=bge-m3cpu

# "Veille réglementaire" GENERATION step only (extraction/reformulation of
# proposed questions & recommandations from a circular) -- separate,
# cloud-first model config, distinct from LLM_* above which stays 100%
# local for bank-side features. Falls back automatically to the local
# model (LLM_* above) if the call fails or REG_LLM_API_KEY is unset --
# leave REG_LLM_API_KEY empty to keep "Veille réglementaire" fully local.
# Get a key at https://aistudio.google.com/apikey -- NEVER commit a real
# key here, this file is tracked by git; put it in your own .env only.
REG_LLM_PROVIDER=openai
REG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
REG_LLM_API_KEY=CHANGE_ME
REG_LLM_MODEL=gemini-3.5-flash
